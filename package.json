{
  "name": "personal-spatial-calibration",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "postinstall": "node scripts/prepare-pose.mjs",
    "predev": "node scripts/prepare-pose.mjs",
    "prebuild": "node scripts/prepare-pose.mjs",
    "test": "tsc src/pose/poseMath.ts src/calibration/machine.ts --target ES2022 --module ES2022 --outDir .pose-test --skipLibCheck && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
